# ── Frontend (Vercel) ─────────────────────────────────────────────
# Muestra un banner informativo en la web cuando está en "true".
VITE_MAINTENANCE_MODE=false
# URL del backend Railway.
VITE_SERVER_URL=https://tradara-production.up.railway.app

# ── Backend (Railway) ─────────────────────────────────────────────
# Clave API de Alpha Vantage (solo backend — ya NO usar VITE_ALPHA_VANTAGE_KEY).
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
# Secret independiente para express-session (distinto de JWT_SECRET).
# Si no está definido, el servidor arranca con un warning y usa JWT_SECRET como fallback.
SESSION_SECRET=generate_a_random_secret_here
