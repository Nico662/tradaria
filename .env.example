# Muestra un banner informativo en la web cuando está en "true".
# No bloquea ninguna funcionalidad — solo avisa al usuario de que hay cambios en curso.
# Valores: "true" | "false" (default: "false")
VITE_MAINTENANCE_MODE=false
# URL del backend Railway. Debe definirse en Vercel (Settings → Environment Variables)
# antes del siguiente deploy de producción, de lo contrario usa el fallback hardcodeado.
VITE_SERVER_URL=https://tradara-production.up.railway.app
