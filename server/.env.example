# ── Obligatorias para arrancar el servidor ──────────────────────────────────
# Clave secreta para firmar y verificar tokens JWT de sesión.
JWT_SECRET=

# URI de conexión a MongoDB (Atlas o local).
MONGODB_URI=

# OAuth de Google — credenciales del proyecto en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis de Upstash — exchange de códigos OAuth y caché.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── Pagos (Stripe) ────────────────────────────────────────────────────────────
# Clave secreta de Stripe (nunca la clave pública aquí).
STRIPE_SECRET_KEY=
# Secreto para verificar webhooks de Stripe.
STRIPE_WEBHOOK_SECRET=
# Secreto compartido para validar recibos de compra in-app (Apple).
IAP_SHARED_SECRET=

# ── Push notifications ────────────────────────────────────────────────────────
# Claves VAPID para Web Push (generadas con web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Clave de firma APNS (Apple Push Notification Service) en base64.
APNS_SIGNING_KEY=

# ── Opcionales / configuración de entorno ────────────────────────────────────
# Secreto para endpoints de administración (ej. /api/admin/trading).
ADMIN_SECRET=
# Clave de Finnhub para datos de mercado adicionales.
FINNHUB_KEY=
# URL del frontend (default: https://tradiko.dev). Usada en OAuth callback.
CLIENT_URL=http://localhost:5173
# URL del callback OAuth en desarrollo local.
OAUTH_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Puerto del servidor (default: 3001).
PORT=3001
# Activar push notifications en local (Railway lo activa automáticamente en prod).
PUSH_ENABLED=false

# ── Trading Mode — Upscale Price Provider ────────────────────────────────────
# Clave API de Upscale Trade (https://upscale.trade). Solo para pruebas locales.
# NUNCA activar en Railway / producción sin permiso escrito de Upscale.
UPSCALE_API_KEY=
# Activar precios reales de Upscale. Mantener en false para desarrollo normal.
USE_UPSCALE_PRICES=false
